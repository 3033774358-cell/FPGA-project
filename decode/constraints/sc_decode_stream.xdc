# =============================================================================
# sc_decode_stream.xdc -- 译码器综合顶层时序约束
# -----------------------------------------------------------------------------
# 【为什么必须有这个文件】
#   综合报告出现 1000 条 TIMING-17 (Bad Practice) 严重警告 = "时序钟未到达寄存器
#   时钟引脚"。根因不是设计有问题, 而是**译码工程没有任何时钟约束** —— Vivado
#   不知道电路要跑多快, 于是把每个寄存器都算作"未被时序钟覆盖"(1000 是规则上限,
#   实际条数更多)。 没有约束时的时序报告(WNS/WHS)不具参考价值。
#   编码器工程一直有 polar_encode_stream.xdc, 所以那边报的是"约束全部满足"。
#
#   本文件与编码器约束保持同一套假设(100MHz 起步), 便于两侧对比。
# =============================================================================

# 100MHz (10ns) 起步。 目标板 YunSDR Y790s (Zynq UltraScale+ RFSoC ZU47DR) 的 PL
# 时钟若为其它频率(如 245.76MHz), 把 -period 改成 1000/目标频率(MHz) 即可。
create_clock -period 10.000 -name clk -waveform {0.000 5.000} [get_ports clk]

# rst_n 异步复位, 只在上电/复位瞬间变化, 不参与时钟域内建立/保持检查
set_false_path -from [get_ports rst_n]

# =============================================================================
# 控制/状态与流式数据口
# -----------------------------------------------------------------------------
# 目前板级下游接口未定(芯片型号/集成方式待定), 先按"板级监视/慢速接口"处理,
# 与编码器 XDC 同样的处理方式。
#   !! 集成到 RFSoC PL 后, 若 mo_valid/mo_bit/mo_last 直接接同一时钟域的下游模块
#      (如帧处理/AXI-Stream 适配), 必须把对应 false_path 换成真实的
#      set_input_delay / set_output_delay, 不能再用 false_path 掩盖。
# =============================================================================
set_false_path -from [get_ports {cfg_start B[*] mcs[*] ftype2 crc_seed[*] \
                                 s_valid s_llr[*] s_last}]
set_false_path -to   [get_ports {s_ready busy done all_crc_ok \
                                 mo_valid mo_bit mo_last}]
