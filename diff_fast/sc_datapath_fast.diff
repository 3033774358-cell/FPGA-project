+
+    wire [FAST_P-1:0] uhat_wr_vec_bits =
+        fd_transform_d1 ? fd_tf_bits : fd_dec_bits;
+
+    wire [INDEX_W-1:0] uhat_wr_vec_index = fd_uhat_addr_d1;
+
